{
  "name": "docker-agent-telegram",
  "version": "0.1.0",
  "description": "Dockerized Telegram Agent powered by Codex & LLM CLIs",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
