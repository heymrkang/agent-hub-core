# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789
# Legacy alias only. If set, this takes precedence over TELEGRAM_ALLOWED_USER_IDS.
# TELEGRAM_ADMIN_USER_ID=123456789

# Execution Timeouts (ms)
CODEX_TIMEOUT_MS=120000
ANTIGRAVITY_TIMEOUT_MS=120000
ANTIGRAVITY_MODEL_DISCOVERY_TIMEOUT_MS=60000

# Execution context (number of previous DB messages, not conversation pairs)
EXECUTION_TAIL_SIZE=3

# Provider concurrency
CODEX_CONCURRENCY=2
ANTIGRAVITY_CONCURRENCY=2

# Phase 8 Internal Scheduler
MODEL_REFRESH_INTERVAL_SECONDS=21600
SCHEDULER_QUEUE_GRACE_SECONDS=30

# Persistent Agent Hub data / user development root
DATA_DIR=/data
WORKSPACE_DIR=/home/dev
REPOS_ROOT=/home/dev/workspace
SSH_DATA_DIR=/data/ssh

# Host Storage Mount Root (for docker-compose.yml volume mounts)
STORAGE_ROOT=/mnt/storage/agent-hub-core

# Phase 9 GitHub Authentication & Git Identity
# Prefer GH_TOKEN. Store the real value only in Coolify Secret/Environment.
# Never commit a real token to this file.
GH_TOKEN=
GITHUB_TOKEN=
GIT_USER_NAME=your_name
GIT_USER_EMAIL=your_email@example.com

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# Preview Gateway & Webhook Domains
PREVIEW_INTERNAL_TOKEN=
PREVIEW_ROUTE_HOST=0.0.0.0
PREVIEW_ROUTE_PORT=8790
PREVIEW_GATEWAY_PORT=8080
PREVIEW_DOMAIN=12190529.xyz
WEBHOOK_DOMAIN=agent-hub.12190529.xyz

# Backend API Preview security gate. External URL stays blocked until an
# unauthenticated probe receives the configured Cloudflare Access challenge.
PREVIEW_TUNNEL_ONLY=false
PREVIEW_CLOUDFLARE_TEAM_DOMAIN=
PREVIEW_CLOUDFLARE_ACCESS_AUD=

# Phase 17 live release gate. Set only for a one-shot verified run; these are
# evidence flags, not service runtime configuration or secrets.
PHASE17_TELEGRAM_PREVIEW_OK=0
PHASE17_CLOUDFLARE_ACCESS_OK=0
PHASE17_OPENAPI_OK=0
PHASE17_AUTHENTICATED_CRUD_OK=0
PHASE17_MARIADB_PERSISTENCE_OK=0
PHASE17_SECRET_REDACTION_OK=0
PHASE17_RESTART_OK=0
PHASE17_CLEANUP_OK=0
PHASE17_WEB_REGRESSION_OK=0

# Phase 20 Deploy & Voice (STT)
COOLIFY_API_TOKEN=
OPENAI_API_KEY=
WEBHOOK_PORT=8788
WEBHOOK_HOST=0.0.0.0
WEBHOOK_SECRET=
