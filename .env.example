# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_USER_ID=123456789

# Execution Timeouts (ms)
CODEX_TIMEOUT_MS=120000
ANTIGRAVITY_TIMEOUT_MS=120000

# Provider concurrency
CODEX_CONCURRENCY=2
ANTIGRAVITY_CONCURRENCY=2

# Phase 8 Internal Scheduler
# Provider model catalog refresh interval (seconds, minimum 3600)
MODEL_REFRESH_INTERVAL_SECONDS=21600

# Persistent data / workspace
DATA_DIR=/data
WORKSPACE_DIR=/workspace
